# Homelab. LocalForward carries the huisarchief quack RPC, which binds
# 127.0.0.1 on the server and is deliberately not exposed on the LAN. The
# tunnel adds no listening port and no second credential path: reaching the
# archive needs an SSH key first, and the quack token on top of that.
#
#   ssh homelab       interactive; the forward lives as long as the session
#   ssh -fN homelab   background tunnel; stays until killed
#
# ControlMaster is set under Host * in the shared ssh_config, so a second
# connection reuses the first one's forward. If ssh warns that 4200 is already
# in use, that is the multiplexed session noticing the master already forwards
# it, and is harmless.
Host homelab
    HostName 192.168.1.186
    User evert
    LocalForward 4200 127.0.0.1:4200

# The devbox is a container on the homelab host with its own sshd.
Host devbox
    HostName 192.168.1.186
    Port 2222
    User evert
