# Push GitHub repos over SSH, so the approving agent asks before every push.
# Git gets no GitHub credentials for HTTPS: public repos still fetch
# anonymously, and an HTTPS push fails instead of going through unasked.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
[credential "https://github.com"]
	helper =

# Written by setup.sh. A literal key:: signing key makes git pass -U, so
# ssh-keygen signs only through the agent and never with a key file on disk.
[include]
	path = ~/.config/git/signing-key.gitconfig
