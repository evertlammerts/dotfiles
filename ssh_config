# Global settings
Host *
    AddKeysToAgent yes
    UseKeychain yes
    TCPKeepAlive yes
    ServerAliveInterval 60
    ServerAliveCountMax 10
    Compression yes
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 10m

# GitHub
Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Homelab. LocalForward carries the huisarchief quack RPC, which binds
# 127.0.0.1 on the server and is deliberately not exposed on the LAN. The
# tunnel adds no listening port and no second credential path: reaching the
# archive needs an SSH key first, and the quack token on top of that.
#
#   ssh homelab       interactive; the forward lives as long as the session
#   ssh -fN homelab   background tunnel; stays until killed
#
# ControlMaster is set under Host * above, so a second connection reuses the
# first one's forward. If ssh warns that 4200 is already in use, that is the
# multiplexed session noticing the master already forwards it, and is harmless.
Host homelab
    HostName 192.168.1.186
    User evert
    LocalForward 4200 127.0.0.1:4200

