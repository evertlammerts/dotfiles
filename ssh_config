# Machine-specific hosts. Include must come before any Host block, and ssh
# skips it silently when the file does not exist.
Include ~/.ssh/config.local

# Global settings
Host *
    AddKeysToAgent yes
    UseKeychain yes
    TCPKeepAlive yes
    ServerAliveInterval 60
    ServerAliveCountMax 10
    Compression yes
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 10m

# GitHub
Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
